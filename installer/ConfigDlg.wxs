<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom "Settings" dialog for the interactive install: server address, expected
  server name, enrollment token, and CA cert path. Inserted into the WixUI_InstallDir
  flow between the Install-Location dialog and the Ready dialog.

  The fields bind to the same properties used for silent install (SERVERADDRESS,
  SERVERNAME, ENROLLTOKEN, CACERTFILE), so interactive and /qn installs share one
  path. CA cert: type/paste the full path (MSI UI browses folders, not files; for
  a file picker use silent install or drop the cert and point CACERTFILE at it).

  NOTE: WiX dialog reflow is version-sensitive — validate with `wix build`. If the
  navigation misbehaves, see installer/README.md for the fallback.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="AegisConfigDlg" Width="370" Height="270" Title="AegisOne Client Setup">
        <!-- Standard banner + header. -->
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUIBannerBmp" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Connection &amp; Enrollment</Text>
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>Where the agent connects and how it enrolls.</Text>
        </Control>

        <!-- Server address -->
        <Control Id="ServerLabel" Type="Text" X="20" Y="60" Width="120" Height="12" Text="Server address (host:port):" />
        <Control Id="ServerEdit" Type="Edit" X="20" Y="73" Width="330" Height="16" Property="SERVERADDRESS" />

        <!-- Server certificate name -->
        <Control Id="NameLabel" Type="Text" X="20" Y="96" Width="200" Height="12" Text="Expected server certificate name (TLS):" />
        <Control Id="NameEdit" Type="Edit" X="20" Y="109" Width="330" Height="16" Property="SERVERNAME" />

        <!-- Enrollment token -->
        <Control Id="TokenLabel" Type="Text" X="20" Y="132" Width="200" Height="12" Text="Enrollment token:" />
        <Control Id="TokenEdit" Type="Edit" X="20" Y="145" Width="330" Height="16" Property="ENROLLTOKEN" />

        <!-- CA cert path -->
        <Control Id="CaLabel" Type="Text" X="20" Y="168" Width="300" Height="12" Text="CA certificate file (full path):" />
        <Control Id="CaEdit" Type="Edit" X="20" Y="181" Width="330" Height="16" Property="CACERTFILE" />

        <!-- Navigation -->
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Insert AegisConfigDlg between InstallDirDlg and VerifyReadyDlg. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="AegisConfigDlg" Order="10">WIXUI_INSTALLDIR_VALID="1"</Publish>
      <Publish Dialog="AegisConfigDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="AegisConfigDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="AegisConfigDlg" Order="10" />
    </UI>
  </Fragment>
</Wix>
