build/
*.exe

# Prebuilt artifacts for the server team ARE tracked (exception to *.exe above).
!dist/*.exe
!dist/*.msi

# Never commit key material or secrets
*key*.txt
*.pem
*.key
private*.txt

# Stray binaries built without -o (go build ./cmd/agent)
/agent
/mockserver
/cachetest
# installer build artifacts (branding assets ARE tracked)
installer/*.msi
installer/*.wixpdb
installer/*.log
