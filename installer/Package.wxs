<?xml version="1.0" encoding="UTF-8"?>
<!--
  AegisOne Client — WiX v4/v5 installer.

  Build:   wix build Package.wxs -arch x64 -ext WixToolset.Util.wixext -ext WixToolset.UI.wixext -o AegisOneClient.msi
  (see installer/README.md for the full build + sign + silent-install runbook)

  IMPORTANT: -arch x64 is REQUIRED. Without it the package builds as x86, every
  component defaults to 32-bit, and HKLM registry writes are redirected to
  HKLM\SOFTWARE\WOW6432Node\AegisOne — where the 64-bit agent (and `reg query
  HKLM\SOFTWARE\AegisOne`) never looks, so the agent silently falls back to its
  built-in defaults (localhost:50051). Files still land correctly because the
  tree is pinned to ProgramFiles64Folder; only the registry view is wrong.

  Interactive install shows: Welcome -> License -> Install Location -> Settings
  (server address / enroll token / CA cert) -> Ready -> Progress -> Finish.

  Silent install, e.g.:
    msiexec /i AegisOneClient.msi /qn ^
      SERVERADDRESS=aegis.corp.local:50051 SERVERNAME=aegis.corp.local ^
      ENROLLTOKEN=tenant-abc-123 CACERTFILE=C:\deploy\ca.crt

  NOTE: validate with `wix build` on a machine with the WiX toolset; custom
  dialogs / custom-action sequencing sometimes need a minor tweak per WiX version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="AegisOne Client"
           Manufacturer="AegisOne"
           Version="1.0.0.0"
           UpgradeCode="7B3A9C1E-4D2F-4E6A-9B10-AE51C0FFEE01"
           Scope="perMachine"
           Compressed="yes">

    <!-- Block downgrades; replace an existing install in place instead of adding a
         second Add/Remove Programs entry. AllowSameVersionUpgrades is required
         because ProductCode is auto-generated (*) per build while Version stays the
         same during development: without it, reinstalling the SAME version is seen
         as a separate product (different ProductCode) and MajorUpgrade — which by
         default only removes STRICTLY older versions — leaves both, producing the
         duplicate appwiz.cpl entry. With it, a reinstall (same or newer version)
         removes the prior AegisOne Client first, so there is always exactly one. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of AegisOne Client is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs icon + metadata. -->
    <Icon Id="AegisIcon" SourceFile="assets/aegisone.ico" />
    <Property Id="ARPPRODUCTICON" Value="AegisIcon" />

    <!-- Install folder, recorded so uninstall can remove the whole tree. -->
    <Property Id="AEGISINSTALLFOLDER">
      <RegistrySearch Id="FindInstallFolder" Root="HKLM" Key="SOFTWARE\AegisOne\Client\Install" Name="InstallFolder" Type="raw" />
    </Property>

    <!-- Settings (overridable in the UI dialog OR on the msiexec command line). -->
    <Property Id="SERVERADDRESS" Value="127.0.0.1:50051" Secure="yes" />
    <Property Id="SERVERNAME" Value="aegis-server" Secure="yes" />
    <Property Id="ENROLLTOKEN" Secure="yes" />
    <Property Id="CACERTFILE" Secure="yes" />
    <!-- Tamper-protection: the unprotect passcode required to UNINSTALL when the agent
         is self-protected. msiexec /x AegisOneClient.msi UNINSTALLPASSCODE=<code>. -->
    <Property Id="UNINSTALLPASSCODE" Secure="yes" />

    <!-- Branding bitmaps + license (swap the files in assets/ to rebrand). -->
    <WixVariable Id="WixUIBannerBmp" Value="assets/banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="assets/dialog.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="assets/license.rtf" />

    <!-- Install tree: <ProgramFiles>\AegisOne\Client (+ SKVC data dirs). -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AegisOne">
        <Directory Id="ClientDir" Name="Client">
          <Directory Id="SKVCDir" Name="SKVC">
            <Directory Id="CertsDir" Name="certs" />
            <Directory Id="LogsDir" Name="logs" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- The agent binary + the Windows service (LocalSystem, auto-start,
         restart-on-failure). Service lifecycle is handled by the MSI. -->
    <ComponentGroup Id="ProductComponents" Directory="ClientDir">
      <!-- Agent binary installs INSIDE SKVC (Client\SKVC\AegisOneClient.exe) so the
           whole agent footprint lives under one SKVC tree. -->
      <Component Id="AgentExeComponent" Directory="SKVCDir" Guid="*">
        <File Id="AgentExeFile" Name="AegisOneClient.exe" Source="..\build\AegisOneClient.exe" KeyPath="yes" />

        <ServiceInstall Id="AegisOneSvcInstall"
                        Name="AegisOneClient"
                        DisplayName="AegisOne Client"
                        Description="AegisOne endpoint management client."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <!-- Restart the service on failure (matches the agent's own install logic). -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60" />
        </ServiceInstall>
        <!-- Start on install, stop on install+uninstall, remove on uninstall. -->
        <ServiceControl Id="AegisOneSvcControl"
                        Name="AegisOneClient"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <!-- On uninstall, recursively delete the whole install tree
             (C:\Program Files\AegisOne), including runtime-created data under SKVC
             (identity, certs, cache, logs) that the MSI did not itself install. -->
        <util:RemoveFolderEx On="uninstall" Property="AEGISINSTALLFOLDER" />
      </Component>

      <!-- The tray UI companion (AegisOneClientUI.exe), installed next to the service
           exe in SKVC. The service launches it into each logged-on user's desktop to
           show the tray icon + user notifications. A separate, separately-signed binary
           (BigFix-style BESClientUI.exe) so it carries its own name + file description. -->
      <Component Id="AgentUIExeComponent" Directory="SKVCDir" Guid="*">
        <File Id="AgentUIExeFile" Name="AegisOneClientUI.exe" Source="..\build\AegisOneClientUI.exe" KeyPath="yes" />
      </Component>

      <!-- Installer-written config in its OWN component (a registry keypath), so
           the registry is a standalone, reliably-versioned resource rather than a
           side-effect of the exe/service component. The agent reads these natively
           from HKLM\SOFTWARE\AegisOne\Client (env > file > registry > default).
           Written at WriteRegistryValues (seq 5000), BEFORE InstallServices/
           StartServices (5800/5900), so the token + server address are available
           at first run. (No util:PermissionEx here — it needs a deferred custom
           action that made the registry unreliable; HKLM is admin/SYSTEM-scoped
           already and the agent erases the single-use token after enrollment.) -->
      <Component Id="ConfigRegistryComponent" Directory="SKVCDir" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\AegisOne\Client">
          <RegistryKey Key="Install">
            <RegistryValue Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            <RegistryValue Name="Version" Type="string" Value="1.0.0.0" />
          </RegistryKey>
          <RegistryKey Key="Connection">
            <RegistryValue Name="AEGIS_SERVER_ADDRESS" Type="string" Value="[SERVERADDRESS]" />
            <RegistryValue Name="AEGIS_TLS_SERVER_NAME" Type="string" Value="[SERVERNAME]" />
          </RegistryKey>
          <RegistryKey Key="Enrollment">
            <RegistryValue Name="AEGIS_ENROLL_TOKEN" Type="string" Value="[ENROLLTOKEN]" />
          </RegistryKey>
          <RegistryKey Key="TLS">
            <RegistryValue Name="AEGIS_TLS_CA" Type="string" Value="[CACERTFILE]" />
            <RegistryValue Name="AEGIS_TLS_CERT" Type="string" Value="[CertsDir]client.crt" />
            <RegistryValue Name="AEGIS_TLS_KEY" Type="string" Value="[CertsDir]client.key" />
          </RegistryKey>
          <RegistryKey Key="Paths">
            <RegistryValue Name="AEGIS_SECURE_DIR" Type="string" Value="[SKVCDir]" />
            <RegistryValue Name="AEGIS_DOWNLOAD_DIR" Type="string" Value="[SKVCDir]download" />
            <RegistryValue Name="AEGIS_WSUS_SCAN_CAB" Type="string" Value="[SKVCDir]wsusscn2.cab" />
          </RegistryKey>
          <RegistryKey Key="Settings">
            <RegistryValue Name="AEGIS_HEALTH_ADDR" Type="string" Value="127.0.0.1:50080" />
          </RegistryKey>
        </RegistryKey>
        <!-- Remove the whole config key on uninstall (replaces ForceDeleteOnUninstall). -->
        <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\AegisOne\Client" Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- UNINSTALL GATE: on a user-initiated uninstall (NOT a major-upgrade removal),
         run the agent's uninstall-check, which verifies UNINSTALLPASSCODE against the
         stored passcode and aborts (non-zero) if the agent is self-protected and no
         valid passcode was given. Immediate + Return=check so a failure aborts the
         uninstall; scheduled after CostFinalize (REMOVE is known) and before any
         files/service are removed. The NOT UPGRADINGPRODUCTCODE condition lets agent
         upgrades through. -->
    <CustomAction Id="CheckUninstallAuth"
                  FileRef="AgentExeFile"
                  ExeCommand="uninstall-check --passcode=[UNINSTALLPASSCODE] --ui=[UILevel]"
                  Execute="immediate"
                  Return="check"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="CheckUninstallAuth" After="CostFinalize"
              Condition="(REMOVE=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="AegisOne Client" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- UI: standard InstallDir wizard + our custom "Connection & Enrollment"
         dialog. Kept in <Package> (not a separate fragment) so it always links. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <Dialog Id="AegisConfigDlg" Width="370" Height="270" Title="AegisOne Client Setup">
        <Control Id="TopLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Connection &amp; Enrollment" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Where the agent connects and how it enrolls." />

        <Control Id="ServerLabel" Type="Text" X="20" Y="60" Width="200" Height="12" Text="Server address (host:port):" />
        <Control Id="ServerEdit" Type="Edit" X="20" Y="73" Width="330" Height="16" Property="SERVERADDRESS" />

        <Control Id="NameLabel" Type="Text" X="20" Y="96" Width="250" Height="12" Text="Expected server certificate name (TLS):" />
        <Control Id="NameEdit" Type="Edit" X="20" Y="109" Width="330" Height="16" Property="SERVERNAME" />

        <Control Id="TokenLabel" Type="Text" X="20" Y="132" Width="250" Height="12" Text="Enrollment token:" />
        <Control Id="TokenEdit" Type="Edit" X="20" Y="145" Width="330" Height="16" Property="ENROLLTOKEN" />

        <Control Id="CaLabel" Type="Text" X="20" Y="168" Width="300" Height="12" Text="CA certificate file (full path):" />
        <Control Id="CaEdit" Type="Edit" X="20" Y="181" Width="330" Height="16" Property="CACERTFILE" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Insert AegisConfigDlg between InstallDirDlg and VerifyReadyDlg. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="AegisConfigDlg" Order="10" Condition="WIXUI_INSTALLDIR_VALID = &quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="AegisConfigDlg" Order="10" />
    </UI>

  </Package>
</Wix>
